# Copy this file to .env before running any just targets.
#   cp .env.example .env

# ── Auth ────────────────────────────────────────────────────────────────────
# Static demo token shared between BlueFlow (API_TOKEN) and TapirXL
# (BLUEFLOW_TOKEN). Both services read this single value — do not split.
BLUEFLOW_API_TOKEN=demo-tapirxl-token-not-for-production

# ── Image tags ───────────────────────────────────────────────────────────────
# Pin exact demo-<semver> tags. Never use `latest`.
BLUEFLOW_TAG=demo-0.3.0
TAPIRXL_TAG=demo-0.3.0
# Viper is built from source — no tag needed here.

# ── VIPER_API_KEY ────────────────────────────────────────────────────────────
# NOT stored here. Generated at runtime after Viper boots.
# After `just smoke`, run:
#   docker compose exec viper npm run db:create-test-api-key
#   export VIPER_API_KEY=<value printed above>
# Then run: just integration
